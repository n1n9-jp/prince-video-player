{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prince-tube",
  // YouTube Data API key is a Worker secret: YOUTUBE_API_KEY
  // wrangler secret put YOUTUBE_API_KEY   (never vars, never VITE_*)
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-23",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "LIBRARY"
    }
  ]
}
